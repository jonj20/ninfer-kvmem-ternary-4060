{
 "type": "Sequence",
 "pretokenizers": [
  {
   "type": "Split",
   "pattern": {
    "Regex": "\\p{N}{1,3}"
   },
   "behavior": "Isolated",
   "invert": false
  },
  {
   "type": "Split",
   "pattern": {
    "Regex": "[一-龥぀-ゟ゠-ヿ]+"
   },
   "behavior": "Isolated",
   "invert": false
  },
  {
   "type": "Split",
   "pattern": {
    "Regex": "[!\"#$%&'()*+,\\-./:;<=>?@\\[\\\\\\]^_`{|}~][A-Za-z]+|[^\r\n\\p{L}\\p{P}\\p{S}]?[\\p{L}\\p{M}]+| ?[\\p{P}\\p{S}]+[\r\n]*|\\s*[\r\n]+|\\s+(?!\\S)|\\s+"
   },
   "behavior": "Isolated",
   "invert": false
  },
  {
   "type": "ByteLevel",
   "add_prefix_space": false,
   "trim_offsets": true,
   "use_regex": false
  }
 ]
}
